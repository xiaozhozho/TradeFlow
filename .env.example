# TradeFlow 环境变量模板
# 复制为 .env 并填写真实值；.env 已被 .gitignore 忽略，请勿提交。

# ---------- OKX 实盘 ----------
OKX_API_KEY=
OKX_SECRETE_KEY=
OKX_PASSPHRASE=

# ---------- OKX 模拟盘 ----------
OKX_API_KEY_SIMULATE=
OKX_SECRETE_KEY_SIMULATE=
OKX_PASSPHRASE_SIMULATE=

# ---------- OKX WebSocket（一般无需修改，统一使用 443 端口） ----------
# OKX_WS_REAL_PUBLIC_URL=wss://ws.okx.com/ws/v5/public
# OKX_WS_REAL_CANDLE_URL=wss://ws.okx.com/ws/v5/business
# OKX_WS_REAL_PRIVATE_URL=wss://ws.okx.com/ws/v5/private
# OKX_WS_SIMULATE_PUBLIC_URL=wss://wspap.okx.com/ws/v5/public
# OKX_WS_SIMULATE_CANDLE_URL=wss://wspap.okx.com/ws/v5/business
# OKX_WS_SIMULATE_PRIVATE_URL=wss://wspap.okx.com/ws/v5/private

# ---------- 网络 ----------
# 默认仅对 OKX 域名使用 IPv4；IPv6 正常的环境可设为 0
OKX_FORCE_IPV4=1

# ---------- DolphinDB ----------
DOLPHINDB_HOST=localhost
DOLPHINDB_PORT=8848
DOLPHINDB_USER=admin
DOLPHINDB_PASSWORD=

# ---------- MySQL（可选） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ---------- Email ----------
EMAIL_SERVER=smtp.qq.com
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER=
EMAIL_REVEIVER=

# ---------- 全局参数 ----------
TIMEOUT=999999
MAX_LOSS=0.3
MAX_PROFIT=999
LEVER=30

# ---------- 路径覆盖（可选） ----------
# TRADEFLOW_ENV_FILE=/abs/path/to/.env
# TRADEFLOW_LOG_DIR=/abs/path/to/log   # 默认：调用脚本同目录/log
